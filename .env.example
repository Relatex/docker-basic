# ============================================
# Laravel Docker Setup
# ============================================
# Diese Datei wird durch setup.sh automatisch generiert.
#
# Verwendung:
#   ./setup.sh <projektname>
#
# Das Skript erstellt eine .env mit automatisch
# zugewiesenen Ports (keine Konflikte bei parallelen Projekten).
# ============================================

PROJECT_NAME=mein-projekt

# Mailpit (Mailfang fuer die Entwicklung)
# setup.sh vergibt die Ports nach dem Index-Schema:
#   SMTP = 1025 + Index, UI = APP_PORT + 82
# Ohne Eintrag greifen die Defaults aus docker-compose.yml (1025 / 8025).
# Bei mehreren parallelen Projekten muessen die Werte gesetzt sein.
MAILPIT_SMTP_PORT=
MAILPIT_UI_PORT=
